# ─────────────────────────────────────────────────────────────────────────────
# Olly Focus Group — .env şablonu
# Bu dosyayı .env olarak kopyala, değerleri doldur, git'e commit etme.
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI — persona agent (GPT-4o ile kullanıcı mesajları üretilir) ────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
PERSONA_TEMPERATURE=0.7

# ── Harness API — chat-agent-tester ─────────────────────────────────────────
# HARNESS_AGENT_KEY doluysa → harness modu otomatik aktif olur
HARNESS_BASE_URL=https://functions.revolutions.social
HARNESS_AGENT_KEY=                        # Bearer token — scripts/seed-agent-constants.ts'den al
HARNESS_BOT_ID=                           # Boş bırakırsan CHAT_AGENT_TESTER_DEFAULT_BOT_ID kullanılır
HARNESS_TIMEOUT_MS=30000                  # Bot yanıt bekleme (max 60000)
HARNESS_FRESH_CONV=true                   # Her koşuda yeni konuşma başlat

# ── Mod kontrolü ─────────────────────────────────────────────────────────────
# MOCK_MODE=true  → hiçbir yere bağlanma, sahte yanıtlar üret (geliştirme için)
# MOCK_MODE=false (default) → HARNESS_AGENT_KEY doluysa harness kullan
MOCK_MODE=false

# ── Eski legacy mod (harness yokken kullanılırdı, artık harness tercih edilir)
# OLLY_API_URL=https://your-backend.com/api/conversation
# OLLY_AUTH_TYPE=bearer
# OLLY_AUTH_VALUE=your-token

# ── Raporlama ─────────────────────────────────────────────────────────────────
REPORTS_DIR=reports
SLACK_WEBHOOK_URL=                        # https://hooks.slack.com/services/...
WEBHOOK_URL=                              # Slack dışı webhook (opsiyonel)

# ── Skorlama eşikleri ─────────────────────────────────────────────────────────
RETENTION_CRITICAL=5.0
RETENTION_IMPROVEMENT=8.0

WEIGHT_ACTION=0.35
WEIGHT_MEMORY=0.25
WEIGHT_INTENT=0.25
WEIGHT_TONE_SAFETY=0.15

WEIGHT_STEP_AVG=0.70
WEIGHT_RETENTION=0.30

# ── Test parametreleri ────────────────────────────────────────────────────────
MAX_STEPS_SHORT=5
MAX_STEPS_LONG=10
REQUEST_TIMEOUT=35                        # saniye (HARNESS_TIMEOUT_MS/1000 + buffer)
